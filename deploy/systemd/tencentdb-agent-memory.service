[Unit]
Description=TencentDB Agent Memory shared multi-agent brain
Documentation=file:///srv/leostudio/apps/tencentdb-agent-memory/docs/studio-continuity.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=leo
Group=docker
WorkingDirectory=/srv/leostudio/apps/tencentdb-agent-memory
Environment=SHARED_BRAIN_CONFIG_ROOT=/srv/leostudio/config/tencentdb-agent-memory
Environment=SHARED_BRAIN_ENV_FILE=/srv/leostudio/config/tencentdb-agent-memory/env.shared-brain
Environment=SHARED_BRAIN_RUNTIME_DIR=/srv/leostudio/config/tencentdb-agent-memory/runtime
ExecStart=/srv/leostudio/apps/tencentdb-agent-memory/deploy/shared-brain-start.sh
ExecReload=/usr/bin/docker compose --env-file /srv/leostudio/config/tencentdb-agent-memory/env.shared-brain up -d --wait memory-core memory-hub
ExecStop=/usr/bin/docker compose --env-file /srv/leostudio/config/tencentdb-agent-memory/env.shared-brain stop memory-hub memory-core
TimeoutStartSec=600
TimeoutStopSec=120
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
