# Bind only to loopback unless external access is separately secured.
BIND_ADDRESS=127.0.0.1
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# Pinned image digests verified on linux/amd64.
MEMORY_CORE_IMAGE=agentmemory/memory-core@sha256:e96a0d20ab14388b3961c5ecc1dd26d48277894c050d40c2c0b9180fb937a4cc
MEMORY_HUB_IMAGE=agentmemory/memory-hub@sha256:3afaa9f8c23ae0648e8d456a9582b67b247b1c2aecceeedd04373ebc27e8f530
PROXY_IMAGE=agentmemory/memory-proxy@sha256:a80b4594a2e737f6a094b3583d68d739cd1389e073a42b39f925f94dfd1f66d0

# Memory extraction LLM. For the host OpenCodex proxy use the container-visible host alias.
MEMORY_LLM_BASE_URL=http://host.docker.internal:10100/v1
MEMORY_LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY_OR_LOCAL_PLACEHOLDER
MEMORY_LLM_MODEL=gpt-5.6-luna

# Optional Gateway bearer gate. Keep blank for the upstream Proxy compatibility limitation.
MEMORY_CORE_GATEWAY_API_KEY=
KNOWLEDGE_PUBLIC_BASE_URL=http://127.0.0.1:8424/v3
